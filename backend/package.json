{
  "name": "devquiz-backend",
  "version": "1.0.0",
  "description": "DevQuiz Edge Backend on Cloudflare Workers + D1 Database",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init:local": "wrangler d1 execute devquiz-db --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute devquiz-db --remote --file=./schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241230.0",
    "typescript": "^5.6.0",
    "wrangler": "^3.101.0"
  }
}
